# 이 파일을 .env 로 복사한 뒤 = 뒤에 발급받은 키를 붙여넣으세요.
#   copy .env.example .env
# .env 는 .gitignore 대상이라 커밋되지 않습니다. 절대 키를 코드나 문서에 직접 쓰지 마세요.

# KOSIS 국가통계포털
# 발급: https://kosis.kr/openapi → 회원가입 → 활용신청 → 즉시 발급(무료)
KOSIS_API_KEY=

# 공공데이터포털 (국민연금 가입 사업장 내역)
# 발급: https://www.data.go.kr → '국민연금공단_국민연금 가입 사업장 내역' 검색 → 활용신청
# 주의: Encoding/Decoding 두 벌 중 어느 쪽을 넣어도 됩니다.
#       (스크립트가 '%' 포함 시 자동으로 디코딩해서 전송합니다)
DATA_GO_KR_SERVICE_KEY=

# 워크넷 / 고용24 채용정보 오픈API
# 발급: https://www.work24.go.kr → 오픈API 활용신청
# 주의: 개인회원 계정으로는 호출이 거부됩니다("개인회원은 사용할 수 없는 OPEN-API입니다").
#       기업(사업자) 회원 전환이 필요합니다.
WORKNET_API_KEY=
